# Imagem de produção (next start). A de desenvolvimento é o Dockerfile.
# NEXT_PUBLIC_* ficam fixas no build, e next.config.mjs volta a ler a URL ao iniciar.
FROM node:26-bookworm-slim

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# O calendário de eventos é desenhado no servidor e no navegador. Com o servidor em UTC, das
# 21h à meia-noite o "hoje" dele já é o dia seguinte, e o do visitante não.
ENV TZ=America/Sao_Paulo

RUN mkdir /app && chown node:node /app
WORKDIR /app
USER node

COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund

COPY --chown=node:node . .

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_GA
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_GA=$NEXT_PUBLIC_GA
RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start", "--", "-H", "0.0.0.0"]
