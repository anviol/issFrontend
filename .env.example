# Modelo das variáveis do frontend. Sem valores reais.
# Copie para .env.local (desenvolvimento) ou .env.production (produção).

# URL do Strapi. É pública, pois monta os links de mídia. Sem ela o Next não sobe.
NEXT_PUBLIC_API_URL=
# Token do Strapi. Só existe no servidor.
API_AUTH_TOKEN=
# ID do Google Analytics
NEXT_PUBLIC_GA=
